---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Blog | Blueprintly';
const description = 'Workspace blueprints, ergonomic gear guides, and setup reviews.';
const permalink = `${Astro.site ? Astro.site.href : 'https://blueprintly.online'}blog`;
---

<html lang="en">
  <head>
    <BaseHead {title} {description} {permalink} />
  </head>

  <body>
    <Header current="blog" />

    <main style="max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem; text-align: center;">
      <h1>Blueprintly Blog</h1>
      <p style="color: #94a3b8; margin-top: 1rem;">Guides and gear breakdowns coming soon!</p>
    </main>

    <Footer />
  </body>
</html>