---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Blueprintly | The Blueprint for a Home Office That Actually Works";
const description = "Honest gear breakdowns, ergonomic layouts, and a free Focus Planner to help you work better without back pain.";
const permalink = Astro.site ? Astro.site.href : "https://blueprintly.online";
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">

    <!-- ========================================= -->
    <!-- 1. HERO with EMAIL CAPTURE                -->
    <!-- ========================================= -->
    <section class="hero">
      <span class="badge">✦ 2026 Blueprint Series</span>
      <h1>
        The <span class="accent">Blueprint</span> for a Home Office<br />
        That Doesn't Hurt Your Back — <span class="accent">or Your Wallet</span>.
      </h1>
      <p class="subheadline">
        Science‑backed ergonomics for small spaces, student budgets, and rental‑friendly setups.  
        Fix your desk pain today — and get our free Focus Planner to start.
      </p>

      <!-- Primary Conversion Zone: Email Capture -->
      <div class="email-capture">
        <!-- Replace your existing form with this -->
        <form action="https://hook.eu2.make.com/2omb9vtbv6jnq4pwgiq9bmky8pz6ffi3" method="POST">
          <input type="email" name="email" placeholder="Enter your email..." required />
          <button type="submit" class="btn btn-primary">
            Get the Free Focus Planner →
          </button>
        </form>

        <div class="capture-trust">
          <span>✓ Free PDF</span>
          <span>✓ No spam</span>
          <span>✓ Unsubscribe anytime</span>
        </div>
      </div>

      <!-- Secondary Action (browse guides) -->
      <div class="secondary-actions">
        <a href="#latest-posts" class="browse-link">Or browse our latest guides ↓</a>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 2. SUB-NICHES (from first code)           -->
    <!-- ========================================= -->
    <section class="sub-niches">
      <h2>What's your workspace challenge?</h2>
      <div class="audience-grid">
        <div class="card">
          <div class="card-icon">📦</div>
          <h3>Small Space</h3>
          <p>Tiny desks, compact gear, and vertical solutions for cramped corners.</p>
          <a href="/blog/category/small-space/" class="card-link">Read more →</a>
        </div>
        <div class="card">
          <div class="card-icon">💰</div>
          <h3>Student Budget</h3>
          <p>Best ergonomic gear under $150, Amazon basics, and DIY hacks.</p>
          <a href="/blog/category/student-budget/" class="card-link">Read more →</a>
        </div>
        <div class="card">
          <div class="card-icon">🔧</div>
          <h3>No‑Damage (Renters)</h3>
          <p>Clamp‑on, adhesive, and freestanding products that leave zero marks.</p>
          <a href="/blog/category/no-damage/" class="card-link">Read more →</a>
        </div>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 3. LATEST POSTS (from first code)         -->
    <!-- ========================================= -->
    <section id="latest-posts" class="latest-posts">
      <h2>Latest Guides</h2>
      <div class="post-list">
        <article class="post-item">
          <a href="/blog/small-desk-setup-guide/">
            <h3>The Ultimate Small Desk Setup Guide</h3>
            <p>Wall mounting, vertical monitors, and storage hacks for tiny workspaces.</p>
          </a>
        </article>
        <article class="post-item">
          <a href="/blog/best-monitor-arms-tiny-desks/">
            <h3>5 Best Wall‑Mounted Monitor Arms for Tiny Desks</h3>
            <p>Budget‑friendly arms that save space and fix your neck pain.</p>
          </a>
        </article>
        <article class="post-item">
          <a href="/blog/student-workspace-guide-under-150/">
            <h3>The Complete Student Workspace Guide (Under $150)</h3>
            <p>Ergonomic setups for students who need comfort without breaking the bank.</p>
          </a>
        </article>
      </div>
      <div class="view-all">
        <a href="/blog/" class="btn btn-secondary">View All Posts →</a>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 4. DISCLOSURE (combined style)            -->
    <!-- ========================================= -->
    <div class="disclosure-banner">
      <p>
        <span>🔍</span> Every recommendation is independently researched and vetted. 
        We earn a small commission if you purchase through our links — at <strong>zero extra cost</strong> to you. 
        It keeps the blueprints free and our advice 100% honest.
      </p>
    </div>

  </div>
</BaseLayout>

<style>
  /* ===== THEME VARIABLES ===== */
  :root {
    --accent-blue: #2563eb;
    --accent-hover: #1d4ed8;
    --card-bg: rgba(0, 0, 0, 0.04);
    --card-border: rgba(0, 0, 0, 0.10);
    --border-color: #e2e8f0;
    --text-secondary: #475569;
    --disclosure-bg: rgba(37, 99, 235, 0.06);
    --disclosure-border: rgba(37, 99, 235, 0.20);
    --disclosure-strong: #1e293b;
  }

  :root.theme-dark {
    --card-bg: rgba(255, 255, 255, 0.03);
    --card-border: rgba(255, 255, 255, 0.08);
    --border-color: #334155;
    --text-secondary: #94a3b8;
    --disclosure-bg: rgba(37, 99, 235, 0.05);
    --disclosure-border: rgba(37, 99, 235, 0.15);
    --disclosure-strong: #ffffff;
  }

  .home-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* ===== HERO ===== */
  .hero {
    text-align: center;
    padding: 2rem 1rem 3rem 1rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue);
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.25);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 600px) {
    .hero h1 { font-size: 2rem; }
  }

  .accent {
    color: var(--accent-blue);
  }

  .subheadline {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== EMAIL CAPTURE ===== */
  .email-capture {
    max-width: 540px;
    margin: 0 auto 1.2rem;
  }

  .capture-form {
    display: flex;
    gap: 0.75rem;
    background: var(--card-bg);
    padding: 0.5rem;
    border-radius: 12px;
    border: 1px solid var(--card-border);
    transition: border-color 0.2s;
  }
  .capture-form:focus-within {
    border-color: var(--accent-blue);
  }

  .capture-form input {
    flex: 1;
    padding: 0.8rem 1.2rem;
    background: transparent;
    border: none;
    font-size: 0.95rem;
    color: inherit;
    outline: none;
    min-width: 0;
  }
  .capture-form input::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--accent-blue);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }
  .btn-secondary:hover {
    background: var(--card-bg);
    border-color: var(--accent-blue);
    color: #ffffff;
  }

  .capture-trust {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 0.8rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
  .capture-trust span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .secondary-actions {
    margin-top: 1.2rem;
  }
  .browse-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: underline dotted;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .browse-link:hover {
    color: var(--accent-blue);
  }

  /* ===== SUB-NICHES ===== */
  .sub-niches {
    padding: 3rem 0 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .sub-niches h2 {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 2rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
    text-align: left;
  }
  .card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-4px);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }
  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .card-link {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 500;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 0.2s;
  }
  .card-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* ===== LATEST POSTS ===== */
  .latest-posts {
    padding: 3rem 0 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .latest-posts h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .post-item {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 1.2rem 1.5rem;
    transition: border-color 0.2s;
  }
  .post-item:hover {
    border-color: var(--accent-blue);
  }

  .post-item a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .post-item p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .view-all {
    text-align: center;
  }

  /* ===== DISCLOSURE BANNER ===== */
  .disclosure-banner {
    margin-top: 3rem;
    background: var(--disclosure-bg);
    border: 1px solid var(--disclosure-border);
    border-radius: 10px;
    padding: 1rem 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .disclosure-banner strong {
    color: var(--disclosure-strong);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .capture-form {
      flex-direction: column;
      background: transparent;
      padding: 0;
      border: none;
    }
    .capture-form input {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
    }
    .capture-form .btn {
      width: 100%;
      justify-content: center;
    }
    .capture-trust {
      flex-wrap: wrap;
      gap: 0.8rem;
    }
    .audience-grid {
      grid-template-columns: 1fr;
    }
    .card {
      text-align: center;
    }
  }
</style>