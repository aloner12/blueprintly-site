
---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Blueprintly | The Blueprint for a Home Office That Actually Works";
const description = "Honest gear breakdowns, ergonomic layouts, and a free Focus Planner to help you work better without back pain.";
const permalink = Astro.site ? Astro.site.href : "https://blueprintly.online";

// 1. Fetch posts and sort by date (newest first)
const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.publishDate || 0).getTime() - new Date(a.data.publishDate || 0).getTime())
  .slice(0, 3);

// 2. Helper function to extract content preview and image safely
const processedPosts = recentPosts.map((post) => {
  // Extract slug safely
  const slug = (post.data as any).slug || post.id;

  // Extract raw body or description text for preview
  const rawText = post.data.description || post.body || '';
  const cleanText = rawText.replace(/[#*`_~]/g, '').trim();
  const truncatedText = cleanText.length > 60 
    ? cleanText.slice(0, 60) + '... Read more' 
    : cleanText + ' Read more';

  // Safely check for images using type assertion (any)
  const data = post.data as any;
  let firstImage = data.heroImage || data.image || null;

  // Fallback: search for markdown image tag ![alt](url) in the body
  if (!firstImage && post.body) {
    const imgMatch = post.body.match(/!\[.*?\]\((.*?)\)/);
    if (imgMatch && imgMatch[1]) {
      firstImage = imgMatch[1];
    }
  }

  return {
    ...post,
    slug,
    previewText: truncatedText,
    image: firstImage,
  };
});
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">

    <!-- ========================================= -->
    <!-- 1. HERO (without email capture)           -->
    <!-- ========================================= -->
    <section class="hero">
      <span class="badge">✦ 2026 Blueprint Series</span>
      <h1>
        The <span class="accent">Blueprint</span> for a Home Office<br />
        That Doesn't Hurt Your Back — <span class="accent">or Your Wallet</span>.
      </h1>
      <p class="subheadline">
        Science‑backed ergonomics for small spaces, student budgets, and rental‑friendly setups.  
        Fix your desk pain today with our in‑depth guides.
      </p>

      <!-- No form – just a clear call‑to‑action to browse -->
      <div class="hero-cta">
        <a href="#latest-posts" class="btn btn-primary">Browse the Guides ↓</a>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 2. SUB-NICHES (unchanged)                  -->
    <!-- ========================================= -->
    <section class="sub-niches">
      <h2>What's your workspace challenge?</h2>
      <div class="audience-grid">
        <div class="card">
          <div class="card-icon">📦</div>
          <h3>Small Space</h3>
          <p>Tiny desks, compact gear, and vertical solutions for cramped corners.</p>
          <a href="/blog/category/small-space/" class="card-link">Read more →</a>
        </div>
        <div class="card">
          <div class="card-icon">💰</div>
          <h3>Student Budget</h3>
          <p>Best ergonomic gear under $150, Amazon basics, and DIY hacks.</p>
          <a href="/blog/category/student-budget/" class="card-link">Read more →</a>
        </div>
        <div class="card">
          <div class="card-icon">🔧</div>
          <h3>No‑Damage (Renters)</h3>
          <p>Clamp‑on, adhesive, and freestanding products that leave zero marks.</p>
          <a href="/blog/category/no-damage/" class="card-link">Read more →</a>
        </div>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 3. LATEST POSTS                           -->
    <!-- ========================================= -->
    <section id="latest-posts" class="latest-posts">
      <h2>Latest Guides</h2>
      <div class="post-list">
        {processedPosts.length > 0 ? (
          processedPosts.map((post) => (
            <article class="post-item">
              <a href={`/blog/${post.slug}/`} class="post-link">
                {post.image && (
                  <div class="post-image-container">
                    <img src={post.image} alt={post.data.title} class="post-image" />
                  </div>
                )}
                <div class="post-content">
                  <h3>{post.data.title}</h3>
                  <p>{post.previewText}</p>
                </div>
              </a>
            </article>
          ))
        ) : (
          <p class="no-posts">No published guides found yet.</p>
        )}
      </div>
      <div class="view-all">
        <a href="/blog/" class="btn btn-secondary">View All Posts →</a>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- 4. DISCLOSURE (theme‑aware)               -->
    <!-- ========================================= -->
    <div class="disclosure-banner">
      <p>
        <span>🔍</span> Every recommendation is independently researched and vetted. 
        We earn a small commission if you purchase through our links — at <strong>zero extra cost</strong> to you. 
        It keeps the blueprints free and our advice 100% honest.
      </p>
    </div>

  </div>
</BaseLayout>

<style>
  /* ===== THEME VARIABLES (Light + Dark) ===== */
  :root {
    --accent-blue: #2563eb;
    --accent-hover: #1d4ed8;
    --card-bg: rgba(0, 0, 0, 0.04);
    --card-border: rgba(0, 0, 0, 0.10);
    --border-color: #e2e8f0;
    --text-secondary: #475569;
    --disclosure-bg: rgba(37, 99, 235, 0.06);
    --disclosure-border: rgba(37, 99, 235, 0.20);
    --disclosure-strong: #1e293b;
  }

  :root.theme-dark {
    --card-bg: rgba(255, 255, 255, 0.03);
    --card-border: rgba(255, 255, 255, 0.08);
    --border-color: #334155;
    --text-secondary: #94a3b8;
    --disclosure-bg: rgba(37, 99, 235, 0.05);
    --disclosure-border: rgba(37, 99, 235, 0.15);
    --disclosure-strong: #ffffff;
  }

  .home-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* ===== HERO ===== */
  .hero {
    text-align: center;
    padding: 2rem 1rem 3rem 1rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue);
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.25);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 600px) {
    .hero h1 { font-size: 2rem; }
  }

  .accent {
    color: var(--accent-blue);
  }

  .subheadline {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    margin-top: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--accent-blue);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }
  .btn-secondary:hover {
    background: var(--card-bg);
    border-color: var(--accent-blue);
    color: #ffffff;
  }

  /* ===== SUB-NICHES ===== */
  .sub-niches {
    padding: 3rem 0 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .sub-niches h2 {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 2rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
    text-align: left;
  }
  .card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-4px);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }
  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .card-link {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 500;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 0.2s;
  }
  .card-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* ===== LATEST POSTS ===== */
  .latest-posts {
    padding: 3rem 0 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .latest-posts h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .post-item {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 1.2rem 1.5rem;
    transition: border-color 0.2s;
  }
  .post-item:hover {
    border-color: var(--accent-blue);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .post-image-container {
    width: 90px;
    height: 70px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.1);
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    flex: 1;
  }

  .post-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .post-item p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .no-posts {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .view-all {
    text-align: center;
  }

  /* ===== DISCLOSURE BANNER ===== */
  .disclosure-banner {
    margin-top: 3rem;
    background: var(--disclosure-bg);
    border: 1px solid var(--disclosure-border);
    border-radius: 10px;
    padding: 1rem 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .disclosure-banner strong {
    color: var(--disclosure-strong);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
    .card {
      text-align: center;
    }
    .post-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .post-image-container {
      width: 100%;
      height: 140px;
    }
  }
</style>